GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Apify account token from https://console.apify.com/account/integrations
APIFY_TOKEN=

# Default actor from the Apify Store:
# https://apify.com/harvestlab/youtube-scraper
# It supports transcript mode with:
# { "mode": "transcript", "videoUrls": ["..."], "transcriptLanguages": ["en","en-US"], "includeTranscripts": true }
APIFY_YOUTUBE_ACTOR_ID=harvestlab/youtube-scraper
APIFY_TRANSCRIPT_LANGUAGES=en,en-US
APIFY_PROXY_GROUPS=RESIDENTIAL

# Optional escape hatch for another pre-made Apify actor.
# Use {{url}} as the pasted YouTube URL placeholder.
# APIFY_ACTOR_INPUT_JSON={"videoUrls":["{{url}}"],"includeTranscripts":true}

# Supabase auth/history later.
# Vite-style names requested for compatibility with existing snippets.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Next.js exposes client env vars only when prefixed with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
